        <mxCell id="data-5" value="&lt;b&gt;staff&lt;/b&gt;&lt;font style=&quot;font-size:10px;color:#55707E;&quot;&gt; · 50 rows&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:3px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;staff_id  PK&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;name · role&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;skill · shift · team&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
