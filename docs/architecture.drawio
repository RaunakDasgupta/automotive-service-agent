        <mxCell id="data-11" value="&lt;b&gt;answer_log&lt;/b&gt;&lt;font style=&quot;font-size:10px;color:#55707E;&quot;&gt; · 601 rows&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:3px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;answer_id  PK · at&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;question · answer&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;route · composed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;grounded · tools&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;citations · warnings&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;seconds&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:3px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;The flywheel's raw material.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;strokeWidth=2;fillColor=#EFE9F8;strokeColor=#7E57C2;fontColor=#271A3D;" vertex="1" parent="1">
