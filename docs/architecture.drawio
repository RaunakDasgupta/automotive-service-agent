          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="life-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;strokeWidth=1.3;" edge="1" parent="1" source="life-9" target="life-6">
