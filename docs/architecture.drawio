        <mxCell id="comp-42" value="&lt;b&gt;Milvus&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#FFF4D6;strokeColor=#D6B656;fontColor=#3D3317;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="754" width="230" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="comp-43" value="&lt;font style=&quot;font-size:11px;&quot;&gt;The vector store. Standalone, on the box, browsable through Attu.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#FFF4D6;strokeColor=#D6B656;fontColor=#3D3317;verticalAlign=middle;" vertex="1" parent="1">
