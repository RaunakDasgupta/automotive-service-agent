        <mxCell id="comp-34" value="&lt;b&gt;NeMo Evaluator&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#EDF6DD;strokeColor=#76B900;fontColor=#1C3307;verticalAlign=middle;" vertex="1" parent="1">
