        <mxCell id="data-7" value="&lt;b&gt;updates&lt;/b&gt;&lt;font style=&quot;font-size:10px;color:#55707E;&quot;&gt; · 1,949 rows&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:3px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;update_id  PK&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;ro_number  → ros&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;staff_id  → staff&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;at · shift&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;text&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;ground_truth&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:3px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;What a technician said. &amp;quot;text&amp;quot; is untrusted input and is treated as such everywhere.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;strokeWidth=2;fillColor=#FFF4D6;strokeColor=#D6B656;fontColor=#3D3317;" vertex="1" parent="1">
