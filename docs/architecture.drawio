        </mxCell>
        <mxCell id="comp-47" value="&lt;font style=&quot;font-size:11px;&quot;&gt;13 metric series scraped into Prometheus and drawn in Grafana — latency by stage, rail activity, NIM errors.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#EFE9F8;strokeColor=#7E57C2;fontColor=#271A3D;verticalAlign=middle;" vertex="1" parent="1">
