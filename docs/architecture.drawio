        <mxCell id="comp-54" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;running&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#5B8C3A;strokeColor=#446B29;strokeWidth=2;fontColor=#FFFFFF;verticalAlign=middle;" vertex="1" parent="1">
