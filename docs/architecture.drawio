          <mxGeometry x="500" y="828" width="220" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="write-14" value="&lt;b&gt;Contradiction surfaced&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;shown, never silently clobbered. Accepting one is an explicit operator act, not a default&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="880" y="828" width="340" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="write-15" value="&lt;b&gt;Append to the event log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;append-only; the only table state is folded from&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="440" y="944" width="340" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="write-16" value="&lt;b&gt;Fold → repair-order snapshot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;state derived from the log, never stored as truth. An illegal transition is rejected and reported&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="440" y="1038" width="340" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="write-17" value="&lt;b&gt;Diff card&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;what changed, since when, by whom&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="440" y="1140" width="340" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="write-18" value="&lt;b&gt;NeMo Curator · quarantine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;drops notes that address the model rather than the record, before they are ever embedded&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#76B900;strokeWidth=2;fontColor=#17301A;" vertex="1" parent="1">
          <mxGeometry x="440" y="1228" width="340" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="write-19" value="&lt;b&gt;NV-EmbedQA E5 v5&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#DCE8CF;&quot;&gt;1024-dimension embeddings&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#5B8C3A;strokeColor=#446B29;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="440" y="1330" width="340" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="write-20" value="&lt;b&gt;Milvus upsert&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;COSINE · AUTOINDEX · strong consistency&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="440" y="1418" width="340" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="write-21" value="&lt;b&gt;Searchable&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#5B8C3A;strokeColor=#446B29;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="510" y="1508" width="200" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="write-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-3" target="write-4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-5" target="write-7">
          <mxGeometry relative="1" as="geometry"/>
