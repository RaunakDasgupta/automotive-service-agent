  <diagram id="write" name="2 · Write path — an update becomes state">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="write-r0"/>
        <mxCell id="1" parent="write-r0"/>
        <mxCell id="write-1" value="&lt;b&gt;WRITE PATH&lt;/b&gt;&lt;font style=&quot;font-size:12px;color:#55707E;&quot;&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;one spoken or typed update, from the shop floor to the event log and the vector store — &lt;i&gt;app/pipeline/run.py&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=20;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#102A38;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1480" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="write-2" value="&lt;b&gt;Shift update&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#E8EEF7;strokeColor=#3A6EA5;strokeWidth=2;fontColor=#13293D;" vertex="1" parent="1">
          <mxGeometry x="510" y="96" width="200" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="write-3" value="&lt;b&gt;audio, or text?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFF4D6;strokeColor=#D6B656;strokeWidth=2;fontColor=#3D3317;" vertex="1" parent="1">
          <mxGeometry x="500" y="180" width="220" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="write-4" value="&lt;b&gt;transcribe() — Riva Parakeet CTC 0.6B&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;gRPC grpc.nvcf.nvidia.com:443 · offline and streaming both implemented · app/pipeline/asr.py&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#EDF6DD;strokeColor=#76B900;fontColor=#1C3307;" vertex="1" parent="1">
          <mxGeometry x="880" y="180" width="340" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="write-5" value="&lt;b&gt;reject&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;empty transcript, no words, wrong sample rate&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#FBE5E5;strokeColor=#B85450;fontColor=#3D1414;" vertex="1" parent="1">
          <mxGeometry x="880" y="282" width="340" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="write-6" value="&lt;b&gt;extract() — Nemotron Nano 8B&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;prose → strict JSON. parse_json() repairs what the model returns before any of it is trusted&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#EDF6DD;strokeColor=#76B900;fontColor=#1C3307;" vertex="1" parent="1">
          <mxGeometry x="440" y="300" width="340" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="write-7" value="&lt;b&gt;validate()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;types, hour ranges, enum membership · app/pipeline/extract.py&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#E8EEF7;strokeColor=#3A6EA5;fontColor=#13293D;" vertex="1" parent="1">
          <mxGeometry x="440" y="404" width="340" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="write-8" value="&lt;b&gt;resolve_ro() + resolve_op()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;spoken digits (&amp;quot;oh one four&amp;quot;), shop aliases, front/rear position words; op code matched against the 104-row catalogue, embedding-assisted above threshold 55&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#E8EEF7;strokeColor=#3A6EA5;fontColor=#13293D;" vertex="1" parent="1">
          <mxGeometry x="440" y="502" width="340" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="write-9" value="&lt;b&gt;repair order resolved?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFF4D6;strokeColor=#D6B656;strokeWidth=2;fontColor=#3D3317;" vertex="1" parent="1">
          <mxGeometry x="500" y="618" width="220" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="write-10" value="&lt;b&gt;clarifying questions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;returned to the speaker. Nothing is written and nothing is guessed — a partial resolution still proceeds with what did resolve&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#E8EEF7;strokeColor=#3A6EA5;fontColor=#13293D;" vertex="1" parent="1">
          <mxGeometry x="880" y="618" width="340" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="write-11" value="&lt;b&gt;reconcile()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;new facts against the current snapshot · app/pipeline/reconcile.py&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#E8EEF7;strokeColor=#3A6EA5;fontColor=#13293D;" vertex="1" parent="1">
          <mxGeometry x="440" y="738" width="340" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="write-12" value="&lt;b&gt;contradicts the snapshot?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFF4D6;strokeColor=#D6B656;strokeWidth=2;fontColor=#3D3317;" vertex="1" parent="1">
          <mxGeometry x="500" y="836" width="220" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="write-13" value="&lt;b&gt;surface the contradiction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;shown, never silently clobbered. accept_conflicts=True is an explicit operator act, not a default&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#FBE5E5;strokeColor=#B85450;fontColor=#3D1414;" vertex="1" parent="1">
          <mxGeometry x="880" y="836" width="340" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="write-14" value="&lt;b&gt;append to events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;append-only · event_id, ro_number, type, at, actor_id, shift, source_update_id, payload&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#FFF4D6;strokeColor=#D6B656;fontColor=#3D3317;" vertex="1" parent="1">
          <mxGeometry x="440" y="956" width="340" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="write-15" value="&lt;b&gt;fold → RO snapshot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;state is derived from the log, never stored as truth. An illegal transition is rejected and reported&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#E8EEF7;strokeColor=#3A6EA5;fontColor=#13293D;" vertex="1" parent="1">
          <mxGeometry x="440" y="1060" width="340" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="write-16" value="&lt;b&gt;render diff card&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;what changed, since when, by whom&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#E8EEF7;strokeColor=#3A6EA5;fontColor=#13293D;" vertex="1" parent="1">
          <mxGeometry x="440" y="1164" width="340" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="write-17" value="&lt;b&gt;NeMo Curator — quarantine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;InstructionLikeFilter drops notes that address the model rather than the record, before they are ever embedded&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#EDF6DD;strokeColor=#76B900;fontColor=#1C3307;" vertex="1" parent="1">
          <mxGeometry x="440" y="1256" width="340" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="write-18" value="&lt;b&gt;embed — nv-embedqa-e5-v5&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;1024-dim · NIM :8001&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#EDF6DD;strokeColor=#76B900;fontColor=#1C3307;" vertex="1" parent="1">
          <mxGeometry x="440" y="1360" width="340" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="write-19" value="&lt;b&gt;Milvus upsert&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;collection &amp;quot;updates&amp;quot; · COSINE · AUTOINDEX&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#FFF4D6;strokeColor=#D6B656;fontColor=#3D3317;" vertex="1" parent="1">
          <mxGeometry x="440" y="1452" width="340" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="write-20" value="&lt;b&gt;searchable&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#E3EEDA;strokeColor=#5C8A1E;strokeWidth=2;fontColor=#1C3307;" vertex="1" parent="1">
          <mxGeometry x="510" y="1552" width="200" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="write-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-2" target="write-3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-4" target="write-6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-6" target="write-7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-7" target="write-8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-8" target="write-9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-11" target="write-12">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-14" target="write-15">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-15" target="write-16">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-16" target="write-17">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-17" target="write-18">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-18" target="write-19">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-19" target="write-20">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-33" value="audio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-3" target="write-4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-34" value="text" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-3" target="write-6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-35" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#B85450;strokeWidth=1.4;endArrow=block;endFill=1;dashed=1;fontSize=10;fontColor=#B85450;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-4" target="write-5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-36" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#B85450;strokeWidth=1.4;endArrow=block;endFill=1;dashed=1;fontSize=10;fontColor=#B85450;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-9" target="write-10">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-37" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-9" target="write-11">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-38" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#B85450;strokeWidth=1.4;endArrow=block;endFill=1;dashed=1;fontSize=10;fontColor=#B85450;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-12" target="write-13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-39" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44616F;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-12" target="write-14">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-40" value="&lt;b&gt;Two principles&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;COMPUTE DETERMINISTICALLY, NARRATE WITH THE LLM. The model turns prose into JSON on the way in and JSON into prose on the way out. It never counts, never infers state and never does arithmetic.&lt;br&gt;&lt;br&gt;UPDATES ARE EVENTS, NOT OVERWRITES. There is a complete audit trail, and contradictions surface instead of being clobbered.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D3DA;fontColor=#33474F;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="330" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="write-41" value="&lt;b&gt;The model is fenced in&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;Every field a technician can influence is untrusted input. The extraction is parsed, type-checked and range-checked before any of it reaches the database, and the free-text fields are carried as data rather than as instructions.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D3DA;fontColor=#33474F;" vertex="1" parent="1">
          <mxGeometry x="60" y="326" width="330" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="write-42" value="&lt;b&gt;Why curate a clean corpus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;Five of the six stages remove nothing, which is the honest result for generated data. The sixth earns the pipeline: it removes the injection vector before indexing, so the retriever can never surface it. Measured: the known payload caught, zero false positives across 1,949 notes.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D3DA;fontColor=#33474F;" vertex="1" parent="1">
          <mxGeometry x="60" y="1256" width="330" height="126" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="read" name="3 · Read path — a question becomes a cited answer">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1580" math="0" shadow="0">
      <root>
        <mxCell id="read-r0"/>
        <mxCell id="1" parent="read-r0"/>
        <mxCell id="read-1" value="&lt;b&gt;READ PATH&lt;/b&gt;&lt;font style=&quot;font-size:12px;color:#55707E;&quot;&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;question → rails → plan → tool → renderer or narration → verification → cited answer — &lt;i&gt;app/agent/agent.py&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=20;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#102A38;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1540" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="read-2" value="&lt;b&gt;Question&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#E8EEF7;strokeColor=#3A6EA5;strokeWidth=2;fontColor=#13293D;" vertex="1" parent="1">
          <mxGeometry x="570" y="96" width="200" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="read-3" value="&lt;b&gt;input rails — always on, before any model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;regex: prompt injection, out of scope, unauthorised instruction · app/guardrails/rails.py&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#FBE5E5;strokeColor=#B85450;fontColor=#3D1414;" vertex="1" parent="1">
          <mxGeometry x="480" y="188" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-4" value="&lt;b&gt;NeMo Guardrails · self check input&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;a prompt task evaluated by the local nano NIM — one call, ~45 ms. Measured 4/4 adversarial blocked, 24/24 legitimate allowed&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#EDF6DD;strokeColor=#76B900;fontColor=#1C3307;" vertex="1" parent="1">
          <mxGeometry x="480" y="284" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-5" value="&lt;b&gt;refusal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;no tool runs and no model narrates · asoia_rail_blocks_total&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#FBE5E5;strokeColor=#B85450;fontColor=#3D1414;" vertex="1" parent="1">
          <mxGeometry x="1000" y="284" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-6" value="&lt;b&gt;plan_for() — choose the tool&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;keyword planner by default. The LLM router exists and is deliberately not paid for: the keyword planner already routes 24 of 24&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#E8EEF7;strokeColor=#3A6EA5;fontColor=#13293D;" vertex="1" parent="1">
          <mxGeometry x="480" y="380" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-7" value="&lt;b&gt;NeMo Switchyard — off unless ASOIA_SWITCHYARD=on&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;route asoia · efficient_first · nano local, nemotron-3-super-120b hosted on escalation&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#F4F4F4;strokeColor=#9E9E9E;fontColor=#555555;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="476" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-8" value="&lt;b&gt;call one of 10 typed tools&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;deterministic SQL and vector reads. No subprocess, no eval of model output, no model-directed sockets&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#E8EEF7;strokeColor=#3A6EA5;fontColor=#13293D;" vertex="1" parent="1">
          <mxGeometry x="480" y="572" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-9" value="&lt;b&gt;free-text search?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFF4D6;strokeColor=#D6B656;strokeWidth=2;fontColor=#3D3317;" vertex="1" parent="1">
          <mxGeometry x="560" y="668" width="220" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="read-10" value="&lt;b&gt;deterministic renderer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;_ros_summary · _ro_state_summary · _handover_summary · _anomaly_summary · _diff_summary · _shift_summary · _vehicles_summary — every count, date and booked-hour figure is computed in Python from the event log&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#E8EEF7;strokeColor=#3A6EA5;fontColor=#13293D;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="370" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="read-11" value="&lt;b&gt;Milvus search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;top-k candidates from the &amp;quot;updates&amp;quot; collection&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#FFF4D6;strokeColor=#D6B656;fontColor=#3D3317;" vertex="1" parent="1">
          <mxGeometry x="1000" y="780" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-12" value="&lt;b&gt;rerank NIM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;nv-rerankqa-mistral-4b-v3 reorders to the passages actually used&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#EDF6DD;strokeColor=#76B900;fontColor=#1C3307;" vertex="1" parent="1">
          <mxGeometry x="1000" y="876" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-13" value="&lt;b&gt;Nemotron narration&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;the one question class a model answers: summarising what technicians wrote. A context-only prompt — it is asked for prose, never for a figure&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#EDF6DD;strokeColor=#76B900;fontColor=#1C3307;" vertex="1" parent="1">
          <mxGeometry x="1000" y="972" width="380" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="read-14" value="&lt;b&gt;check_grounding()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;every digit and decimal in the text must appear in the tool payload. Decimals matter most: booked hours are what a manager acts on&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#FBE5E5;strokeColor=#B85450;fontColor=#3D1414;" vertex="1" parent="1">
          <mxGeometry x="480" y="1092" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-15" value="&lt;b&gt;check_negations()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;a flipped &amp;quot;not&amp;quot; inverts the operational meaning of a safety answer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#FBE5E5;strokeColor=#B85450;fontColor=#3D1414;" vertex="1" parent="1">
          <mxGeometry x="480" y="1188" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-16" value="&lt;b&gt;check_output() — unauthorised-release claim&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;is &amp;quot;approved for release&amp;quot; supported by the payload, or invented? This runs in Python because it needs the payload — a prose rail cannot see it, which is why there is no self_check_output task&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#FBE5E5;strokeColor=#B85450;fontColor=#3D1414;" vertex="1" parent="1">
          <mxGeometry x="480" y="1284" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-17" value="&lt;b&gt;answer + citations&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;[RO-…] [UPD-…] with route, tools used and warnings attached&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#E8EEF7;strokeColor=#3A6EA5;fontColor=#13293D;" vertex="1" parent="1">
          <mxGeometry x="480" y="1380" width="380" height="68" as="geometry"/>
        </mxCell>
