          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="data-24" value="&lt;b&gt;Why derived means rebuildable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;Milvus holds no fact that SQLite does not. Dropping the collection and re-running the index loses nothing, which is what makes editing the vector store safe to offer at all.&lt;br&gt;&lt;br&gt;The reverse is not true: events can never be rebuilt from anything, which is why they are append-only and why every application read of the SQLite file is opened mode=ro.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D3DA;fontColor=#33474F;" vertex="1" parent="1">
          <mxGeometry x="730" y="620" width="240" height="168" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="life" name="7 · Repair order lifecycle">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="820" math="0" shadow="0">
      <root>
