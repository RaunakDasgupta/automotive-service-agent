        <mxCell id="write-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-12" target="write-13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-15" target="write-16">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-16" target="write-17">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-17" target="write-18">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-18" target="write-19">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-19" target="write-20">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-20" target="write-21">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-34" value="spoken" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-4" target="write-5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-35" value="typed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-4" target="write-7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-36" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#C1562A;strokeWidth=1.4;endArrow=block;endFill=1;dashed=1;fontSize=10;fontColor=#9E441F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-5" target="write-6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-37" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#C1562A;strokeWidth=1.4;endArrow=block;endFill=1;dashed=1;fontSize=10;fontColor=#9E441F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-10" target="write-11">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-38" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-10" target="write-12">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-39" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#C1562A;strokeWidth=1.4;endArrow=block;endFill=1;dashed=1;fontSize=10;fontColor=#9E441F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-13" target="write-14">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-40" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-13" target="write-15">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="write-41" value="&lt;b&gt;Two principles&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;COMPUTE DETERMINISTICALLY, NARRATE WITH THE MODEL. The model turns prose into JSON on the way in and JSON into prose on the way out. It never counts, never infers state and never does arithmetic.&lt;br&gt;&lt;br&gt;UPDATES ARE EVENTS, NOT OVERWRITES. A complete audit trail, and contradictions surface instead of being clobbered.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#AEB7AC;fontColor=#33403A;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="330" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="write-42" value="&lt;b&gt;The model is fenced in&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;Every field a technician can influence is untrusted input. The extraction is parsed, type-checked and range-checked before any of it reaches the database, and free text is carried as data rather than as instructions.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#AEB7AC;fontColor=#33403A;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="330" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="write-43" value="&lt;b&gt;Why curate a clean corpus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;Five of the six stages remove nothing, which is the honest result for generated data. The sixth earns the pipeline: it removes the injection vector before indexing, so the retriever can never surface it. The known payload is caught with zero false positives across 1,949 notes.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#AEB7AC;fontColor=#33403A;" vertex="1" parent="1">
          <mxGeometry x="60" y="1228" width="330" height="126" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="read" name="3 · Read path">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1580" math="0" shadow="0">
      <root>
        <mxCell id="read-r0"/>
        <mxCell id="1" parent="read-r0"/>
        <mxCell id="read-1" value="&lt;b&gt;READ PATH&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=20;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#101814;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="1480" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="read-2" value="a question becomes a cited answer — rails, plan, tool, composer or narration, verification" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#4A5A52;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1480" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="read-3" value="&lt;b&gt;Question&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#14302A;strokeWidth=2;fontColor=#14302A;" vertex="1" parent="1">
          <mxGeometry x="570" y="112" width="200" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="read-4" value="&lt;b&gt;Pattern rails — always on, before any model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;prompt injection, out of scope, unauthorised instruction&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="480" y="202" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-5" value="&lt;b&gt;NeMo Guardrails · self check input&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;a prompt task judged by the local Nemotron NIM — one call, about 45 ms. Measured 4/4 adversarial blocked, 24/24 legitimate allowed&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#76B900;strokeWidth=2;fontColor=#17301A;" vertex="1" parent="1">
          <mxGeometry x="480" y="298" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-6" value="&lt;b&gt;Refusal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;no tool runs and no model narrates; the block is counted&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="1000" y="298" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-7" value="&lt;b&gt;Query planner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;keyword-first. The model router exists and is deliberately not paid for: the planner already routes 24 of 24&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="480" y="394" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-8" value="&lt;b&gt;NeMo Switchyard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;nano locally, Nemotron Super hosted on escalation. Off unless the deployment turns it on&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#76B900;strokeWidth=2;fontColor=#17301A;" vertex="1" parent="1">
          <mxGeometry x="480" y="490" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-9" value="&lt;b&gt;Tool layer · one of 10 typed tools&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;deterministic SQL and vector reads. No subprocess, no eval of model output, no model-directed sockets&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="480" y="586" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-10" value="&lt;b&gt;free-text search?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#14302A;strokeWidth=2;fontColor=#14302A;" vertex="1" parent="1">
          <mxGeometry x="560" y="682" width="220" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="read-11" value="&lt;b&gt;Answer composers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;one per tool shape. Every count, date and booked-hour figure is computed in Python from the event log, so these paths make no model call at all&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="370" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="read-12" value="&lt;b&gt;Milvus vector search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;top-k candidates from the updates collection&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="1000" y="790" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-13" value="&lt;b&gt;NV-RerankQA Mistral 4B&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#DCE8CF;&quot;&gt;reorders to the passages actually used&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#5B8C3A;strokeColor=#446B29;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1000" y="886" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-14" value="&lt;b&gt;Nemotron narration&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#DCE8CF;&quot;&gt;the one question class a model answers: summarising what technicians wrote. Asked for prose, never for a figure&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#5B8C3A;strokeColor=#446B29;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1000" y="982" width="380" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="read-15" value="&lt;b&gt;Grounding check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;every digit and decimal in the text must appear in the tool payload. Decimals matter most — booked hours are what a manager acts on&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="480" y="1098" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-16" value="&lt;b&gt;Negation check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;a flipped &amp;quot;not&amp;quot; inverts the meaning of a safety answer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="480" y="1194" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-17" value="&lt;b&gt;Release-claim rail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;is &amp;quot;approved for release&amp;quot; supported by the payload, or invented? This runs in code because it needs the payload — a prose rail cannot see it&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="480" y="1290" width="380" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="read-18" value="&lt;b&gt;Answer + citations&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;every claim tied to a repair order and an update id&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
