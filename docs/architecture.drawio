          <mxGeometry x="60" y="262" width="1400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="dep-9" value="&lt;b&gt;NVIDIA DCGM exporter · :9401&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#DCE8CF;&quot;&gt;utilisation, framebuffer, power, temperature and clocks, scraped every 10 seconds. 9401 because the application already holds 9400.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#5B8C3A;strokeColor=#446B29;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="70" y="292" width="1380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="dep-10" value="&lt;b&gt;Datastores&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontStyle=1;fillColor=#1E4035;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="362" width="1400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="dep-11" value="&lt;b&gt;Milvus standalone · :19530&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;the vector store; metrics on :9091&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="60" y="392" width="457" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="dep-12" value="&lt;b&gt;SQLite — system of record&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;every application read is read-only except the single writer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="531" y="392" width="457" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="dep-13" value="&lt;b&gt;An unused embedded store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;present and NOT in use — the startup report names it so it cannot be mistaken for the live one again&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="1002" y="392" width="457" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="dep-14" value="&lt;b&gt;Application&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontStyle=1;fillColor=#1E4035;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="484" width="1400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="dep-15" value="&lt;b&gt;HTTP API · :8080&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;27 routes, OpenAPI at /docs&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="60" y="514" width="457" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="dep-16" value="&lt;b&gt;Operations console · :7860&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;6 tabs, optional public link&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="531" y="514" width="457" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="dep-17" value="&lt;b&gt;Metrics exporter · :9400&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;separate from the API port, which is why :8080/metrics is a 404&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="1002" y="514" width="457" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="dep-18" value="&lt;b&gt;Operator surfaces — bound to loopback, reached over one SSH forward&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontStyle=1;fillColor=#1E4035;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="dep-19" value="&lt;b&gt;Prometheus · :9090&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;named volume; retention survives a recreate&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="60" y="630" width="339" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="dep-20" value="&lt;b&gt;Grafana · :3000&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;provisioned dashboard, GPU row included&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="413" y="630" width="339" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="dep-21" value="&lt;b&gt;Attu · :8101&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;the Milvus browser&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="766" y="630" width="339" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="dep-22" value="&lt;b&gt;sqlite-web · :8102&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;the system-of-record browser&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
          <mxGeometry x="1119" y="630" width="339" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="dep-23" value="&lt;b&gt;One command up, one command down&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;Milvus first, because the API reads the store; then the NIMs, the API, the console, the store browsers, DCGM and the observability stack. Every start prints a report naming which store is actually serving, so the question &amp;quot;which database am I looking at?&amp;quot; is answered before it is asked.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#AEB7AC;fontColor=#33403A;" vertex="1" parent="1">
          <mxGeometry x="60" y="716" width="680" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="dep-24" value="&lt;b&gt;Why the vector browser needs a container IP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;Milvus sits on docker's default bridge, which has no embedded DNS, and a container reaching the published port on the gateway address times out on this box. So the launcher resolves the container IP at start and recreates the browser if it has moved. Diagnosed rather than guessed; the alternative was a browser that silently showed an empty store.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#AEB7AC;fontColor=#33403A;" vertex="1" parent="1">
          <mxGeometry x="760" y="716" width="700" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="dep-25" value="&lt;b&gt;Exposure&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontStyle=1;fillColor=#1E4035;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="848" width="1400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="dep-26" value="&lt;b&gt;What is reachable from outside the box&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;The optional public console link, and nothing else. The API, the vector store, Grafana, Prometheus and both store browsers are not exposed beyond the instance; the operator surfaces are loopback-bound and reached with an SSH forward. The API key lives in an ignored environment file, is never committed and is never printed — the stack verifies the line length after every edit rather than echoing the value.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#AEB7AC;fontColor=#33403A;" vertex="1" parent="1">
          <mxGeometry x="60" y="878" width="1400" height="88" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
