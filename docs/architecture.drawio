        </mxCell>
        <mxCell id="comp-55" value="&lt;b&gt;Milvus&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="230" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="comp-56" value="&lt;font style=&quot;font-size:11px;&quot;&gt;The vector store. Standalone on the box, browsable, and rebuildable from the event log.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
