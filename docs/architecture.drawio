        <mxCell id="comp-58" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;running — not an NVIDIA product, but the store in NVIDIA's own RAG reference stack&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1174" y="1000" width="406" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="comp-59" value="&lt;b&gt;NVIDIA Brev&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#5B8C3A;strokeColor=#446B29;strokeWidth=2;fontColor=#FFFFFF;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1063" width="230" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="comp-60" value="&lt;font style=&quot;font-size:11px;&quot;&gt;The deployment target. One L40S carrying all three NIMs and everything else.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="278" y="1063" width="480" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="comp-61" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;L40S 48 GB&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="766" y="1063" width="400" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="comp-62" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;running&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#5B8C3A;strokeColor=#446B29;strokeWidth=2;fontColor=#FFFFFF;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1174" y="1063" width="406" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="comp-63" value="&lt;b&gt;NemoClaw / OpenShell&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#76B900;strokeWidth=2;dashed=1;dashPattern=6 4;fontColor=#4A7023;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1126" width="230" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-64" value="&lt;font style=&quot;font-size:11px;&quot;&gt;Would add a containment boundary and a sandboxed compute tool, so derived figures could be computed rather than narrated.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="278" y="1126" width="480" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-65" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;agent sandbox gateway&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="766" y="1126" width="400" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-66" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;&lt;b&gt;BLOCKED — platform fault&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#76B900;strokeWidth=2;dashed=1;dashPattern=6 4;fontColor=#4A7023;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1174" y="1126" width="406" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-67" value="&lt;b&gt;What the one blocked row actually costs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;The containment boundary, and a sandboxed compute tool that would let derived figures be computed rather than narrated. What it does not cost: any of the four acceptance criteria, any other row, or the flywheel — the sandbox is a boundary around steps, not a step in the loop. Nothing in the current agent executes untrusted code: the ten tools are deterministic SQL and vector reads, with no subprocess, no evaluation of model output and no model-directed network calls.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#AEB7AC;fontColor=#33403A;" vertex="1" parent="1">
          <mxGeometry x="40" y="1215" width="1540" height="96" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
