        <mxCell id="comp-46" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;running&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#76B900;strokeWidth=2;fontColor=#17301A;verticalAlign=middle;" vertex="1" parent="1">
