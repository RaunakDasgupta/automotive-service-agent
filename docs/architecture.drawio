        <mxCell id="comp-46" value="&lt;b&gt;Observability&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#EFE9F8;strokeColor=#7E57C2;fontColor=#271A3D;verticalAlign=middle;" vertex="1" parent="1">
