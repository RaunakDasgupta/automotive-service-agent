        <mxCell id="arch-1" value="&lt;b&gt;AGENTIC AI USE CASE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=20;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#101814;" vertex="1" parent="1">
