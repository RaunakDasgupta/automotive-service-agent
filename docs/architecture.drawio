        </mxCell>
        <mxCell id="comp-45" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;tool and model intercepts&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="766" y="763" width="400" height="74" as="geometry"/>
