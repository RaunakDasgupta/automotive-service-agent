        </mxCell>
        <mxCell id="read-40" value="&lt;b&gt;The flywheel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;Every answer is logged together with the payload it was built from. scripts/make_eval_dataset.py turns those rows into a dataset, evals/asoia_byob.py scores it in NeMo Evaluator's own schema, and the scores gate the next change. The agent's own output is what measures it.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D3DA;fontColor=#33474F;" vertex="1" parent="1">
          <mxGeometry x="60" y="112" width="370" height="124" as="geometry"/>
        </mxCell>
        <mxCell id="read-41" value="&lt;b&gt;Where the model is not&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;Five of six question classes never reach an LLM. That is not a cost saving — it is the reason the figures can be trusted and the reason the deterministic measures sit at a 100% floor rather than a hopeful one.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D3DA;fontColor=#33474F;" vertex="1" parent="1">
          <mxGeometry x="60" y="254" width="370" height="110" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
