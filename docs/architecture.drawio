        <mxCell id="data-1" value="&lt;b&gt;DATA MODEL&lt;/b&gt;&lt;font style=&quot;font-size:12px;color:#55707E;&quot;&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;SQLite is the system of record; Milvus is derived from it and can always be rebuilt. Row counts read from the running box&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=20;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#102A38;" vertex="1" parent="1">
