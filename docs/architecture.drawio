        <mxCell id="comp-32" value="&lt;font style=&quot;font-size:10px;&quot;&gt;scripts/curate.py · isolated .venv-curator&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D3DA;fontColor=#33474F;verticalAlign=middle;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="756" y="522" width="430" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="comp-33" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;running · run/curation/&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#EDF6DD;strokeColor=#76B900;fontColor=#1C3307;verticalAlign=middle;" vertex="1" parent="1">
