        <mxCell id="data-12" value="&lt;b&gt;Milvus collection &amp;quot;updates&amp;quot;&lt;/b&gt;&lt;font style=&quot;font-size:10px;color:#55707E;&quot;&gt; · one row per update&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:3px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;pk  INT64  PK&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;vector  FLOAT_VECTOR(1024)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;update_id · ro_number&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;staff_id · staff_name&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;at · shift&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;text  VARCHAR(8192)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;vehicle · category · concern · vin&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:3px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;AUTOINDEX, COSINE, strong consistency. AUTOINDEX picks FLAT at this size — exact, not approximate; at two thousand rows an ANN index would trade recall for nothing.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;strokeWidth=2;fillColor=#EDF6DD;strokeColor=#76B900;fontColor=#1C3307;" vertex="1" parent="1">
          <mxGeometry x="990" y="124" width="440" height="197" as="geometry"/>
        </mxCell>
        <mxCell id="data-13" value="&lt;b&gt;RO snapshot&lt;/b&gt;&lt;font style=&quot;font-size:10px;color:#55707E;&quot;&gt; · computed, never stored&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:3px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;state  (1 of 13)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;blocking · at_risk · safety flags&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;booked hours · assigned tech&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;contradictions outstanding&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:3px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;Folded from events on every read. There is no status column anywhere that could drift from the log.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;strokeWidth=2;fillColor=#EDF6DD;strokeColor=#76B900;fontColor=#1C3307;" vertex="1" parent="1">
