        <mxCell id="write-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#14302A;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#33403A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write-9" target="write-10">
          <mxGeometry relative="1" as="geometry"/>
