        <mxCell id="comp-49" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;running · loopback only&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#EFE9F8;strokeColor=#7E57C2;fontColor=#271A3D;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1194" y="822" width="386" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="comp-50" value="&lt;b&gt;NemoClaw / OpenShell&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#F4F4F4;strokeColor=#9E9E9E;fontColor=#555555;dashed=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="904" width="230" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="comp-51" value="&lt;font style=&quot;font-size:11px;&quot;&gt;Would give a containment boundary and a sandboxed compute tool. Not reachable: the gateway launchable's sshd rejects a certificate signed by its own Brev CA.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#F4F4F4;strokeColor=#9E9E9E;fontColor=#555555;dashed=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="278" y="904" width="470" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="comp-52" value="&lt;font style=&quot;font-size:10px;&quot;&gt;openshell 0.1.2 in the venv · scripts/openshell_gateway.py&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D3DA;fontColor=#33474F;verticalAlign=middle;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="756" y="904" width="430" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="comp-53" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;&lt;b&gt;BLOCKED — platform fault, reproduces on a fresh launchable&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;strokeWidth=2;fillColor=#FBE5E5;strokeColor=#B85450;fontColor=#3D1414;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1194" y="904" width="386" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="comp-54" value="&lt;b&gt;What the blocked row actually costs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;The containment boundary, and a sandboxed compute tool that would let derived figures be computed rather than narrated. What it does not cost: any of the four acceptance criteria, any other row, or the flywheel — NemoClaw is a boundary around steps, not a step in the loop. Nothing in the current agent executes untrusted code: the ten tools are deterministic SQL and vector reads, with no subprocess, no eval of model output and no model-directed sockets.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D3DA;fontColor=#33474F;" vertex="1" parent="1">
          <mxGeometry x="40" y="996" width="1540" height="92" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dep" name="5 · Deployment and ports">
