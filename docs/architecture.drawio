        <mxCell id="comp-51" value="&lt;b&gt;NVIDIA DCGM&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#5B8C3A;strokeColor=#446B29;strokeWidth=2;fontColor=#FFFFFF;verticalAlign=middle;" vertex="1" parent="1">
