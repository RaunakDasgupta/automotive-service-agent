        </mxCell>
        <mxCell id="data-23" value="fold" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#5B8C3A;strokeWidth=1.4;endArrow=block;endFill=1;dashed=1;fontSize=10;fontColor=#446B29;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="data-8" target="data-13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="data-24" value="&lt;b&gt;Why derived means rebuildable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5C6B64;&quot;&gt;Milvus holds no fact that SQLite does not. Dropping the collection and re-running the index loses nothing, which is what makes editing the vector store safe to offer at all.&lt;br&gt;&lt;br&gt;The reverse is not true: events can never be rebuilt from anything, which is why they are append-only and why every application read of the SQLite file is opened mode=ro.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#AEB7AC;fontColor=#33403A;" vertex="1" parent="1">
          <mxGeometry x="730" y="620" width="240" height="168" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
