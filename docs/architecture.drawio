        </mxCell>
        <mxCell id="comp-48" value="&lt;font style=&quot;font-size:10px;&quot;&gt;app/obs/metrics.py · configs/prometheus.yml · scripts/start_observability.sh&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D3DA;fontColor=#33474F;verticalAlign=middle;fontFamily=Courier New;" vertex="1" parent="1">
