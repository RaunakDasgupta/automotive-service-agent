          <mxGeometry x="40" y="842" width="230" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-48" value="&lt;font style=&quot;font-size:11px;&quot;&gt;Routing proxy: the efficient model locally, the capable one hosted when something raises confidence.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
