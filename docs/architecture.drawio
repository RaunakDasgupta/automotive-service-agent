        <mxCell id="comp-31" value="&lt;b&gt;NeMo Guardrails&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#76B900;strokeWidth=2;fontColor=#17301A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="526" width="230" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-32" value="&lt;font style=&quot;font-size:11px;&quot;&gt;The input rail, judged by the local model against this project's own safety policy rather than a generic one.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="278" y="526" width="480" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-33" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;self check input rail&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="766" y="526" width="400" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-34" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;running&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#76B900;strokeWidth=2;fontColor=#17301A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1174" y="526" width="406" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-35" value="&lt;b&gt;NeMo Curator&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#76B900;strokeWidth=2;fontColor=#17301A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="605" width="230" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-36" value="&lt;font style=&quot;font-size:11px;&quot;&gt;Six-stage curation. Five find nothing in generated data; the sixth quarantines the injection vector before indexing.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="278" y="605" width="480" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-37" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;heuristic filters + a custom quarantine stage&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="766" y="605" width="400" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-38" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;running&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#76B900;strokeWidth=2;fontColor=#17301A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1174" y="605" width="406" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-39" value="&lt;b&gt;NeMo Evaluator&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#76B900;strokeWidth=2;fontColor=#17301A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="684" width="230" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-40" value="&lt;font style=&quot;font-size:11px;&quot;&gt;The six measures as BYOB benchmarks, emitted in Evaluator's own result schema so one run is comparable with the last.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="278" y="684" width="480" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-41" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;BYOB benchmarks, scored from recorded answers&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="766" y="684" width="400" height="74" as="geometry"/>
