  <diagram id="arch" name="1 · Architecture">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="arch-r0"/>
        <mxCell id="1" parent="arch-r0"/>
        <mxCell id="arch-1" value="&lt;b&gt;AGENTIC AI USE CASE — Automotive Service Operations Intelligence Agent&lt;/b&gt;&lt;font style=&quot;font-size:12px;color:#55707E;&quot;&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;voice and text shift updates → derived repair-order state → a grounded agent&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=20;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#102A38;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="arch-2" value="&lt;b style=&quot;font-size:13px;&quot;&gt;OBJECTIVE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;A service department's true state lives in what technicians say during the shift, and it is lost: spoken updates never reach the DMS, the advisor re-walks the shop to answer &quot;is this car safe to release?&quot;, and the handover between shifts is rebuilt from memory. Status is stale, blocked vehicles sit unnoticed, and nobody can show how a figure was arrived at.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#F4F8EC;strokeColor=#76B900;fontColor=#1C3307;" vertex="1" parent="1">
          <mxGeometry x="40" y="82" width="800" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="arch-3" value="&lt;b style=&quot;font-size:13px;&quot;&gt;BUSINESS OUTCOME&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;• Capture the shift by speaking, not by typing into a DMS&lt;br&gt;• Surface blocked and at-risk vehicles the moment they block&lt;br&gt;• Hand over a shift in one prioritised, cited page&lt;br&gt;• Every figure computed and traceable to an update id — auditable by construction&lt;br&gt;• Runs on one L40S: no customer data leaves the box&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FDF1EC;strokeColor=#D79B7A;fontColor=#3D2314;" vertex="1" parent="1">
          <mxGeometry x="860" y="82" width="800" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="arch-4" value="ARCHITECTURE&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-weight:normal;font-size:10px;&quot;&gt;lanes run top to bottom; the write path and the read path are drawn on pages 2 and 3&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fontStyle=1;fillColor=#102A38;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="212" width="1620" height="26" as="geometry"/>
        </mxCell>
