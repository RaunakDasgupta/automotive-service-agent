        <mxCell id="comp-29" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;NeMo Agent Toolkit workflow&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
