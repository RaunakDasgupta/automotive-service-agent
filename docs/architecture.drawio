        </mxCell>
        <mxCell id="comp-28" value="&lt;font style=&quot;font-size:11px;&quot;&gt;The agent declared as a toolkit workflow: a react agent over the same ten typed tools.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="278" y="463" width="480" height="58" as="geometry"/>
