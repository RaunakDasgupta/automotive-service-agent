        <mxCell id="data-6" value="&lt;b&gt;labour_ops&lt;/b&gt;&lt;font style=&quot;font-size:10px;color:#55707E;&quot;&gt; · 104 rows&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:3px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;op_code  PK&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;description · category&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;flat_rate_hrs · min_skill&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family:Courier New;font-size:10px;&quot;&gt;safety_critical&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:3px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-size:9.5px;color:#55707E;&quot;&gt;The catalogue resolve_op() matches against.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;" vertex="1" parent="1">
