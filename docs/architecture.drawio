        <mxCell id="comp-42" value="&lt;font style=&quot;font-size:10.5px;&quot;&gt;running&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#76B900;strokeWidth=2;fontColor=#17301A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1174" y="684" width="406" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-43" value="&lt;b&gt;NeMo Relay&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#76B900;strokeWidth=2;fontColor=#17301A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="763" width="230" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="comp-44" value="&lt;font style=&quot;font-size:11px;&quot;&gt;Records how an answer was produced — which tool, which model, how long each span took — rather than only what it said.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FCFCFA;strokeColor=#AEB7AC;strokeWidth=1;fontColor=#1C2B25;verticalAlign=middle;" vertex="1" parent="1">
