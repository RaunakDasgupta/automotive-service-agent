# Copy to .env and fill in. .env is gitignored and must never be committed.
# Get a key from https://build.nvidia.com (free tier: ~40 requests/minute).
NVIDIA_API_KEY=nvapi-your-key-here

# The vector store. Unset falls back to embedded Milvus Lite at
# data/generated/milvus.db, which takes an EXCLUSIVE FILE LOCK - one process at a
# time, so the UI and the API cannot both be up. Standalone has no such problem:
#   bash scripts/start_milvus.sh up
ASOIA_MILVUS_URI=http://localhost:19530

# Where the models run. This project targets a Brev L40S with the three NIM
# containers on it, so `local` is the default and the intended setting.
#
#   local    the containers on this box. The only mode with a reranker, and the
#            only one with a non-reasoning chat model.
#   auto     probe for a local NIM, fall back to hosted if it is not up.
#   hosted   build.nvidia.com. SKIPS THE LOCAL PROBE ENTIRELY - all three
#            containers can be pulled, built and healthy while every request
#            still leaves the box. Nothing errors; `scripts/stack.sh status`
#            notes it as "N local NIM container(s) up and NOTHING routes to
#            them". This is a degraded fallback for when there is no GPU, not a
#            configuration to leave in place on one.
#
# Changing this CHANGES THE EMBEDDER, and the two are different widths -
# nv-embedqa-e5-v5 is 1024, the hosted nemotron-3-embed-1b is 2048 - so rebuild
# the index after you switch it or every search fails on a dimension mismatch.
#
# Forgetting is caught: build() records the embedder it used, and /health fails
# with "the index was built with X (2048-dimensional) and this process is
# configured for Y" plus the rebuild command. Row counts and update ids match
# perfectly after a switch, so nothing else notices.
NIM_MODE=local

# Per-service override. Only useful when the rest is NOT local: there is NO
# hosted reranking model, so with NIM_MODE=hosted the second retrieval stage
# fails
#   HTTP 404: 404 page not found
# on every query and the vector order stands unchanged. This routes only the
# reranker to the local container, leaving the hosted embedder - and the
# 2048-dimensional index built with it - untouched. With NIM_MODE=local, which
# is the default above, it is redundant.
# NIM_MODE_RERANK=local

# The instance name, so `scripts/stack.sh stores` prints the ssh -L command
# filled in. Everything binds 127.0.0.1, so a forward is how you reach the UI,
# Grafana, Attu and sqlite-web from your own machine.
# ASOIA_SSH_ALIAS=capstone-asoia

# Required before scripts/stack.sh will publish a public gradio.live link. That
# link is world-reachable and the Technician Update tab writes to the event log.
# GRADIO_AUTH=demo:choose-something

# Optional. Pins "now". You do not need it: the clock follows the newest event in
# the log, so a dataset never goes stale. Set it only when you want a fixed
# clock, e.g. to reproduce a specific run.
# ASOIA_NOW=2026-09-24T20:03:00
