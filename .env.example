# Copy to .env and fill in. .env is gitignored and must never be committed.
# Get a key from https://build.nvidia.com (free tier: ~40 requests/minute).
NVIDIA_API_KEY=nvapi-your-key-here

# The vector store. Unset falls back to embedded Milvus Lite at
# data/generated/milvus.db, which takes an EXCLUSIVE FILE LOCK - one process at a
# time, so the UI and the API cannot both be up. Standalone has no such problem:
#   bash scripts/start_milvus.sh up
ASOIA_MILVUS_URI=http://localhost:19530

# Where the models run. `auto` probes for a local NIM and falls back to the
# hosted endpoints; `hosted` skips the probe; `local` requires the containers.
# Changing this CHANGES THE EMBEDDER, and the two are different widths -
# nemotron-3-embed-1b is 2048, nv-embedqa-e5-v5 is 1024 - so rebuild the index
# after you switch it or every search fails on a dimension mismatch.
#
# Forgetting is caught now: build() records the embedder it used, and /health
# fails with "the index was built with X (2048-dimensional) and this process is
# configured for Y" plus the rebuild command. Row counts and update ids match
# perfectly after a switch, so nothing else notices.
NIM_MODE=hosted

# Per-service override, and the one you probably want. There is NO hosted
# reranking model: with NIM_MODE=hosted the second retrieval stage fails
#   HTTP 404: 404 page not found
# on every single query and the vector order stands unchanged. This routes only
# the reranker to the local container, leaving the hosted embedder - and the
# 2048-dimensional index built with it - untouched. Needs the container:
#   bash scripts/start_nims.sh run
# NIM_MODE_RERANK=local

# Required before scripts/stack.sh will publish a public gradio.live link. That
# link is world-reachable and the Technician Update tab writes to the event log.
# GRADIO_AUTH=demo:choose-something

# Optional. Pins "now". You do not need it: the clock follows the newest event in
# the log, so a dataset never goes stale. Set it only when you want a fixed
# clock, e.g. to reproduce a specific run.
# ASOIA_NOW=2026-09-24T20:03:00
